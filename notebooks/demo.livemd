# Diavasi demo

```elixir
Mix.install([
  {:kino, "~> 0.14"},
  {:req, "~> 0.5"},
  {:diavasi_client, path: Path.expand("..", __DIR__)}
])
```

## Intro

This notebook starts `diavasi serve`, synthetic groups, and the Python and Elixir clients. Each group uses the built-in `u64` generator (`total_records`, `batch_max_records`), so the notebook does not register a database connection. A group that reads an adapter sets `connection_id` and `source_spec` on `POST /v1/groups` instead.

Build the server from [diavasi](https://github.com/diavasis/diavasi) and put the `diavasi` binary on `PATH`. Install the Python client with `pip install diavasi-client==0.1.0`. The Python CLI prints `record_ids` and `batch_ids`. `Diavasi.Client.run/1` returns `{:ok, record_ids, batch_ids}`.

## Setup

```elixir
bin =
  System.get_env("DIAVASI_BIN") ||
    System.find_executable("diavasi") ||
    raise "diavasi is not on PATH; build diavasi from the server repository"

python =
  System.get_env("DIAVASI_PYTHON") ||
    System.find_executable("python3") ||
    raise "python3 is not on PATH; pip install diavasi-client==0.1.0"

python_env =
  case System.get_env("DIAVASI_PYTHONPATH") do
    nil -> []
    path -> [{"PYTHONPATH", path}]
  end

token = "demo-token"
store_key = Base.encode16(:crypto.strong_rand_bytes(32), case: :lower)

free_port = fn ->
  {:ok, socket} = :gen_tcp.listen(0, [:binary, ip: {127, 0, 0, 1}, reuseaddr: true])
  {:ok, port} = :inet.port(socket)
  :gen_tcp.close(socket)
  port
end

control_port = free_port.()
data_port = free_port.()
work = Path.join(System.tmp_dir!(), "diavasi-demo-#{control_port}")
File.mkdir_p!(work)
store = Path.join(work, "meta.redb")
ca = Path.join(work, "dataplane-ca.crt")
base = "http://127.0.0.1:#{control_port}"
data_addr = "127.0.0.1:#{data_port}"

:ok
```

## Start the server

```elixir
server =
  spawn(fn ->
    port =
      Port.open({:spawn_executable, bin}, [
        :binary,
        :exit_status,
        :stderr_to_stdout,
        args: [
          "serve",
          "--bind",
          "127.0.0.1:#{control_port}",
          "--data-bind",
          data_addr,
          "--store",
          store,
          "--token",
          token,
          "--store-key",
          store_key
        ]
      ])

    loop = fn loop ->
      receive do
        {:stop, from} ->
          Port.close(port)
          send(from, :stopped)

        _other ->
          loop.(loop)
      end
    end

    loop.(loop)
  end)

deadline = System.monotonic_time(:millisecond) + 10_000

wait = fn wait ->
  case Req.get(base <> "/health", retry: false) do
    {:ok, %{status: 200}} ->
      :ok

    _ ->
      if System.monotonic_time(:millisecond) > deadline do
        raise "server did not become healthy at #{base}/health"
      else
        Process.sleep(100)
        wait.(wait)
      end
  end
end

wait.(wait)
Kino.Markdown.new("Control plane at `#{base}`. Data plane at `#{data_addr}`. CA: `#{ca}`.")
```

## Synthetic groups

Each client gets its own group so both can read the full id range. The source is the synthetic `u64` generator, not a database.

```elixir
auth = {:bearer, token}

create = fn id, total, batch ->
  body = %{
    group_id: id,
    total_records: total,
    payload_size: 4,
    max_buffer_records: 64,
    max_buffer_bytes: 1_048_576,
    batch_max_records: batch,
    batch_timeout_ms: 1_000,
    ordering_contract: "synthetic-u64",
    connection_id: nil
  }

  Req.post!(base <> "/v1/groups", auth: auth, json: body)
  Req.post!(base <> "/v1/groups/#{id}/start", auth: auth)
end

create.("py", 20, 5)
create.("ex", 20, 5)

status = Req.get!(base <> "/v1/status", auth: auth).body
py = Req.get!(base <> "/v1/groups/py", auth: auth).body
checkpoint = Req.get!(base <> "/v1/groups/py/checkpoint", auth: auth).body

Kino.Layout.grid(
  [
    Kino.Markdown.new("**Status**"),
    Kino.Inspect.new(status),
    Kino.Markdown.new("**Group `py`** (Elixir group `ex` uses the same shape)"),
    Kino.Inspect.new(py),
    Kino.Markdown.new("**Checkpoint** before any consumer"),
    Kino.Inspect.new(checkpoint)
  ],
  columns: 1
)
```

## Consume with both clients

```elixir
{:ok, elixir_ids, _elixir_batches} =
  Diavasi.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "ex",
    consumer: "ex1",
    total: 20,
    max_in_flight: 2
  )

{python_out, 0} =
  System.cmd(
    python,
    [
      "-m",
      "diavasi_client",
      "--addr",
      data_addr,
      "--ca",
      ca,
      "--token",
      token,
      "--group",
      "py",
      "--consumer",
      "py1",
      "--total",
      "20"
    ],
    env: python_env,
    stderr_to_stdout: true
  )

python_ids =
  python_out
  |> String.split("\n", trim: true)
  |> Enum.find_value([], fn line ->
    case String.split(line) do
      ["record_ids" | ids] -> Enum.map(ids, &String.to_integer/1)
      _ -> nil
    end
  end)

after_checkpoint = Req.get!(base <> "/v1/groups/ex/checkpoint", auth: auth).body

Kino.Layout.grid(
  [
    Kino.DataTable.new([
      %{consumer: "ex1", count: length(elixir_ids), record_ids: Enum.join(elixir_ids, " ")},
      %{consumer: "py1", count: length(python_ids), record_ids: Enum.join(python_ids, " ")}
    ]),
    Kino.Markdown.new("**Checkpoint** for group `ex` after the Elixir client left"),
    Kino.Inspect.new(after_checkpoint)
  ],
  columns: 1
)
```

## Same group

Python and Elixir join group `shared` together. Each stops after 10 records. The ids they ack are disjoint, and together they are `1` through `20`.

```elixir
create.("shared", 20, 5)

python_task =
  Task.async(fn ->
    System.cmd(
      python,
      [
        "-m",
        "diavasi_client",
        "--addr",
        data_addr,
        "--ca",
        ca,
        "--token",
        token,
        "--group",
        "shared",
        "--consumer",
        "py-share",
        "--total",
        "10",
        "--max-in-flight",
        "1"
      ],
      env: python_env,
      stderr_to_stdout: true
    )
  end)

{:ok, elixir_share, _elixir_share_batches} =
  Diavasi.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "shared",
    consumer: "ex-share",
    total: 10,
    max_in_flight: 1
  )

{python_out, 0} = Task.await(python_task, 45_000)

python_share =
  python_out
  |> String.split("\n", trim: true)
  |> Enum.find_value([], fn line ->
    case String.split(line) do
      ["record_ids" | ids] -> Enum.map(ids, &String.to_integer/1)
      _ -> nil
    end
  end)

shared = MapSet.new(1..20)
elixir_set = MapSet.new(elixir_share)
python_set = MapSet.new(python_share)
overlap = MapSet.intersection(elixir_set, python_set) |> MapSet.to_list() |> Enum.sort()
union = MapSet.union(elixir_set, python_set)

unless MapSet.equal?(union, shared) and overlap == [] do
  raise "shared group split was not a partition: elixir=#{inspect(elixir_share)} python=#{inspect(python_share)}"
end

Kino.DataTable.new([
  %{consumer: "ex-share", count: length(elixir_share), record_ids: Enum.join(elixir_share, " ")},
  %{consumer: "py-share", count: length(python_share), record_ids: Enum.join(python_share, " ")},
  %{consumer: "overlap", count: length(overlap), record_ids: Enum.join(overlap, " ")}
])
```

## Disconnect and requeue

The first consumer acks one batch of 5, then drops the connection on the next batch without acking it. Those record ids are requeued. The second consumer reads the 15 records still outstanding, including that batch.

```elixir
create.("requeue", 20, 5)

{:ok, dropped, _dropped_batches} =
  Diavasi.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "requeue",
    consumer: "drop",
    total: 20,
    max_in_flight: 1,
    halt_after: 1
  )

Process.sleep(300)

{:ok, resumed, _resumed_batches} =
  Diavasi.Client.run(
    addr: data_addr,
    ca: ca,
    token: token,
    group: "requeue",
    consumer: "resume",
    total: 15,
    max_in_flight: 2
  )

requeued =
  MapSet.intersection(MapSet.new(dropped), MapSet.new(resumed))
  |> MapSet.to_list()
  |> Enum.sort()

Kino.DataTable.new([
  %{consumer: "drop", count: length(dropped), record_ids: Enum.join(dropped, " ")},
  %{consumer: "resume", count: length(resumed), record_ids: Enum.join(resumed, " ")},
  %{consumer: "requeued", count: length(requeued), record_ids: Enum.join(requeued, " ")}
])
```

## Stop

```elixir
send(server, {:stop, self()})

receive do
  :stopped -> Kino.Markdown.new("Server stopped. Store left at `#{work}`.")
after
  2_000 -> Kino.Markdown.new("Stop signal sent.")
end
```
